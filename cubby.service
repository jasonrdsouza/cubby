[Unit]
Description=Cubby server
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=3
User=jason
ExecStart=/usr/local/bin/cubby serve -path /var/data/cubby.db -port=8081 -max=200

# Hardening: cubby only needs to write its database, so make the rest of
# the filesystem read-only. ReadWritePaths must contain the -path directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/data

[Install]
WantedBy=multi-user.target

